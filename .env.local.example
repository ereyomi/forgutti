# PostgreSQL connection string for storing captured leads.
# Works with Supabase, Neon, Railway, RDS, or any managed/self-hosted Postgres.
DATABASE_URL=postgres://user:password@host:5432/dbname?sslmode=require

# Set to "false" for a local Postgres without SSL support.
# Leave unset (or "true") for managed providers that require SSL.
# DATABASE_SSL=false
